    excelInput.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files);
        let addedCount = 0;
        let skipCount = 0;
        let errorCount = 0;
        const failureReasons = [];

        for (const file of files) {
            const isDuplicate = queue.some(item => item.file.name === file.name && item.file.size === file.size);
            if (isDuplicate) {
                skipCount++;
                failureReasons.push({
                    fileName: file.name,
                    reason: 'Fail pendua — nama dan saiz fail sama dengan fail yang telah dimuat naik.'
                });
                continue;
            }

            if (appMode === 'master') {
                const masterData = await getMasterWorkbookData(file);

                if (!masterData || !masterData.sheets.length) {
                    errorCount++;
                    failureReasons.push({
                        fileName: file.name,
                        reason: 'Fail gabungan tidak dapat dibaca atau tiada sheet data yang sah.'
                    });
                    continue;
                }

                let validSheetCount = 0;
                for (const sheet of masterData.sheets) {
                    const meta = sheet.meta || {};
                    const missing = [];
                    if (!meta.year) missing.push('TAHUN DATA');
                    if (!meta.session) missing.push('SESI PENTAKSIRAN');

                    if (missing.length) {
                        failureReasons.push({
                            fileName: `${file.name} [${sheet.sheetName}]`,
                            reason: `Metadata tidak lengkap — tiada ${missing.join(' dan ')}. Gunakan fail gabungan yang mempunyai metadata tahun dan sesi.`
                        });
                        errorCount++;
                        continue;
                    }

                    queue.push({
                        file,
                        workbook: masterData.workbook,
                        jsonData: sheet.rows,
                        className: 'MULTI KELAS',
                        cohort: null,
                        detectedGrade: 'MULTI TAHAP',
                        dataYear: String(meta.year).trim(),
                        detectedDataYear: String(meta.year).trim(),
                        assessmentSession: String(meta.session).trim().toUpperCase(),
                        schoolName: String(meta.school || '').trim(),
                        detectedPeriod: String(meta.year).trim(),
                        type: sheet.type,
                        gradeDetectedFromFilename: false,
                        classDetectedFromFilename: false,
                        periodDetectedFromFilename: false,
                        isMaster: true,
                        sourceSheet: sheet.sheetName
                    });
                    validSheetCount++;
                }

                if (validSheetCount) addedCount++;
                continue;
            }

            const workbookData = await getWorkbookData(file);
            if (!workbookData) {
                errorCount++;
                failureReasons.push({
                    fileName: file.name,
                    reason: 'Fail Excel tidak dapat dibaca. Fail mungkin rosak, format tidak sah, dilindungi kata laluan atau kandungan fail tidak serasi.'
                });
                continue;
            }

            const fileInfo = detectFileInfo(file.name);
            const cohort = getCohortFromData(workbookData.jsonData);

            const dataYear = yearSelect.value;
            const assessmentSession = assessmentSelect.value;
            const schoolName = schoolNameInput.value.trim();

            // Semak tahun sebenar daripada nama fail jika maklumat itu tersedia.
            const detectedDataYear = detectDataYearFromFileName(file.name);
            if (detectedDataYear && detectedDataYear !== dataYear) {
                errorCount++;
                failureReasons.push({
                    fileName: file.name,
                    reason: `Tahun tidak sepadan — fail dikesan sebagai data ${detectedDataYear}, tetapi Tahun Data yang dipilih ialah ${dataYear}.`
                });
                continue;
            }

            const detectedPeriod = fileInfo.session || dataYear;
            const detectedGrade = fileInfo.detectedGrade || detectGradeFromCohort(cohort, detectedPeriod);
            const detectedClass = fileInfo.className || detectClassNameFromData(workbookData.jsonData) || 'KELAS TIDAK DIKETAHUI';
            const type = detectType(workbookData.jsonData, file.name);

            // Peraturan sesi:
            // Pertengahan Sesi Akademik = PB sahaja
            // Akhir Sesi Akademik = PB + UASA
            if (assessmentSession === 'PERTENGAHAN SESI AKADEMIK' && type === 'UASA') {
                errorCount++;
                failureReasons.push({
                    fileName: file.name,
                    reason: 'Jenis pentaksiran tidak sesuai — UASA tidak dibenarkan untuk Pertengahan Sesi Akademik. Pertengahan Sesi Akademik menerima PB sahaja.'
                });
                continue;
            }

            queue.push({
                file,
                workbook: workbookData.workbook,
                jsonData: workbookData.jsonData,
                className: detectedClass,
                cohort,
                detectedGrade,
                dataYear,
                detectedDataYear,
                assessmentSession,
                schoolName,
                detectedPeriod,
                type,
                gradeDetectedFromFilename: Boolean(fileInfo.detectedGrade),
                classDetectedFromFilename: Boolean(fileInfo.className),
                periodDetectedFromFilename: Boolean(fileInfo.session)
            });
            addedCount++;
        }

        let msg = '';
        if (addedCount) msg += `${addedCount} fail berjaya dimasukkan. `;
        if (skipCount) msg += `${skipCount} fail pendua diabaikan. `;
        if (errorCount) msg += `${errorCount} fail tidak dimasukkan. Lihat sebab di bawah.`;
        if (msg) {
            const statusType = errorCount && !addedCount ? 'error' : (errorCount ? 'info' : (addedCount ? 'success' : 'info'));
            showStatus(msg.trim(), statusType);
        }

        renderErrorDetails(failureReasons);
        renderFileList();
        updatePreview();
        convertBtn.disabled = queue.length === 0;
        clearBtn.disabled = queue.length === 0;
        excelInput.value = '';
    });

