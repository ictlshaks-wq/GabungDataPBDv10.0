    function normalizedHeaderKey(key) {
        return String(key || '')
            .toUpperCase()
            .replace(/[._\-]/g,' ')
            .replace(/\s+/g,' ')
            .trim();
    }


    function isIdentityColumn(key) {
        const k = normalizedHeaderKey(key);
        return [
            'NO IC','NO. IC','NO KP','NO. KP','NOKP','NO K/P','NO. K/P',
            'NO KAD PENGENALAN','NOMBOR KAD PENGENALAN','MYKAD','IC'
        ].includes(k);
    }

    function normalizeIdentityValue(value) {
        if (value === null || value === undefined || value === '') return '';

        // Jika datang sebagai nombor, tukar kepada integer penuh tanpa notasi saintifik.
        if (typeof value === 'number' && Number.isFinite(value)) {
            return Math.trunc(value).toLocaleString('fullwide', {
                useGrouping: false,
                maximumFractionDigits: 0
            });
        }

        let s = String(value).trim();

        // Tangani notasi saintifik seperti 9.01234567891E+11.
        if (/^[+-]?\d+(\.\d+)?e[+-]?\d+$/i.test(s)) {
            const n = Number(s);
            if (Number.isFinite(n)) {
                s = Math.trunc(n).toLocaleString('fullwide', {
                    useGrouping: false,
                    maximumFractionDigits: 0
                });
            }
        }

        // Buang apostrophe Excel di hadapan jika ada.
        s = s.replace(/^'/, '');

        // Untuk IC Malaysia, kekalkan digit sahaja jika jelas 12 digit selepas buang pemisah.
        const digits = s.replace(/\D/g, '');
        if (digits.length === 12) return digits;

        return s;
    }

    function preserveIdentityColumns(rows) {
        return (rows || []).map(row => {
            const out = { ...row };
            for (const key of Object.keys(out)) {
                if (isIdentityColumn(key)) {
                    out[key] = normalizeIdentityValue(out[key]);
                }
            }
            return out;
        });
    }

    function shouldRemoveSourceColumn(key) {
        const k = normalizedHeaderKey(key);
        return ['BIL','NO BIL','KELAS','NAMA KELAS','CLASS','TAHUN','TINGKATAN','SESI','TAHAP','TAHUN/SESI','TAHUN SESI','TAHUN DATA','TAHUN_DATA','SESI PENTAKSIRAN','SESI_PENTAKSIRAN','NAMA SEKOLAH','NAMA_SEKOLAH'].includes(k);
    }

    function cleanRows(item, counter) {
        return preserveIdentityColumns(item.jsonData).map(row => {
            const cleaned = {};
            for (const k in row) {
                if (!shouldRemoveSourceColumn(k)) cleaned[k] = row[k];
            }
            return {
                'NO BIL': counter.value++,
                'NAMA SEKOLAH': item.schoolName || '',
                'TAHUN DATA': item.dataYear,
                'SESI PENTAKSIRAN': item.assessmentSession,
                'TAHAP': item.detectedGrade,
                'KELAS': item.className,
                ...cleaned
            };
        });
    }


    function forceIdentityColumnsAsText(ws) {
        if (!ws || !ws['!ref']) return;
        const range = XLSX.utils.decode_range(ws['!ref']);

        const headerMap = {};
        for (let c = range.s.c; c <= range.e.c; c++) {
            const addr = XLSX.utils.encode_cell({ r: range.s.r, c });
            const cell = ws[addr];
            if (!cell) continue;
            headerMap[c] = String(cell.v ?? '');
        }

        for (let c = range.s.c; c <= range.e.c; c++) {
            if (!isIdentityColumn(headerMap[c])) continue;

            for (let r = range.s.r + 1; r <= range.e.r; r++) {
                const addr = XLSX.utils.encode_cell({ r, c });
                const cell = ws[addr];
                if (!cell || cell.v === null || cell.v === undefined || cell.v === '') continue;

                cell.v = normalizeIdentityValue(cell.v);
                cell.t = 's';
                cell.z = '@';
            }
        }
    }

    function setUsefulColumnWidths(ws) {
        const range = XLSX.utils.decode_range(ws['!ref'] || 'A1:A1');
        const widths = [];
        for (let c = range.s.c; c <= range.e.c; c++) {
            let maxLen = 10;
            for (let r = range.s.r; r <= Math.min(range.e.r, 200); r++) {
                const cell = ws[XLSX.utils.encode_cell({r,c})];
                if (!cell || cell.v == null) continue;
                maxLen = Math.max(maxLen, String(cell.v).length);
            }
            widths.push({ wch: Math.min(maxLen + 2, 38) });
        }
        ws['!cols'] = widths;
        ws['!autofilter'] = { ref: ws['!ref'] };
    }

    clearBtn.addEventListener('click', () => {
        if (!queue.length) return;

        const confirmClear = window.confirm('Kosongkan semua data yang telah dimuat naik?');
        if (!confirmClear) return;

        queue = [];
        excelInput.value = '';

        renderFileList();
        updatePreview();

        convertBtn.disabled = true;
        clearBtn.disabled = true;

        statusBox.classList.add('hidden');
        statusBox.innerText = '';
        renderErrorDetails([]);
    });


    function validateFinalSessionCompleteness(items) {
        const groups = new Map();

        for (const item of items) {
            const session = String(item.assessmentSession || '').toUpperCase();
            if (session !== 'AKHIR SESI AKADEMIK') continue;

            const year = String(item.dataYear || '').trim() || 'TAHUN TIDAK DIKETAHUI';
            const key = year;

            if (!groups.has(key)) {
                groups.set(key, { year, hasPB:false, hasUASA:false });
            }

            const group = groups.get(key);
            if (item.type === 'PB') group.hasPB = true;
            if (item.type === 'UASA') group.hasUASA = true;
        }

        const problems = [];
        for (const group of groups.values()) {
            if (!group.hasPB || !group.hasUASA) {
                let missing = [];
                if (!group.hasPB) missing.push('PB');
                if (!group.hasUASA) missing.push('UASA');

                problems.push(
                    `Data Akhir Sesi Akademik ${group.year} belum lengkap — tiada ${missing.join(' dan ')}.`
                );
            }
        }

        return problems;
    }

    convertBtn.addEventListener('click', async () => {
        try {
            let currentSchoolName = '';

            if (appMode === 'class') {
                if (!schoolNameInput.value.trim()) {
                    showStatus('Sila isi Nama Sekolah sebelum menjana fail gabungan.', 'error');
                    schoolNameInput.focus();
                    return;
                }
                currentSchoolName = schoolNameInput.value.trim();
                queue.forEach(item => item.schoolName = currentSchoolName);
            } else {
                const schools = [...new Set(queue.map(i => String(i.schoolName || '').trim()).filter(Boolean))];
                currentSchoolName = schools.length === 1 ? schools[0] : (schools[0] || 'DATA GABUNGAN');
            }

            const invalid = appMode === 'class'
                ? queue.filter(i => i.className === 'KELAS TIDAK DIKETAHUI' || i.detectedGrade.includes('TIDAK DIKETAHUI'))
                : [];
            if (invalid.length) {
                showStatus(`Terdapat ${invalid.length} fail yang Tingkatan/Tahun atau Nama Kelas belum dikenal pasti. Sila semak sebelum gabung.`, 'error');
                return;
            }

            const finalSessionProblems = validateFinalSessionCompleteness(queue);
            if (finalSessionProblems.length) {
                showStatus(
                    `${finalSessionProblems.join(' ')} Untuk Akhir Sesi Akademik, fail PB dan UASA perlu dimuat naik sebelum digabungkan.`,
                    'error'
                );
                return;
            }

            showStatus('Menjana fail Excel multi-tab...', 'info');

            let pbData = [];
            let uasaData = [];
            let otherData = [];
            const pbCounter = {value:1};
            const uasaCounter = {value:1};
            const otherCounter = {value:1};

            for (const item of queue) {
                const rows = item.isMaster
                    ? item.jsonData.map(row => ({ ...row }))
                    : cleanRows(
                        item,
                        item.type === 'PB' ? pbCounter : item.type === 'UASA' ? uasaCounter : otherCounter
                    );

                if (item.type === 'PB') pbData = pbData.concat(rows);
                else if (item.type === 'UASA') uasaData = uasaData.concat(rows);
                else otherData = otherData.concat(rows);
            }

            // Jika gabung fail master, nombor bil disusun semula selepas semua tahun/sesi dicantum.
            if (appMode === 'master') {
                const renumber = rows => rows.map((row, idx) => ({ ...row, 'NO BIL': idx + 1 }));
                pbData = renumber(pbData);
                uasaData = renumber(uasaData);
                otherData = renumber(otherData);
            }

            const wb = XLSX.utils.book_new();

            if (pbData.length) {
                const wsPB = XLSX.utils.json_to_sheet(pbData);
                forceIdentityColumnsAsText(wsPB);
                setUsefulColumnWidths(wsPB);
                XLSX.utils.book_append_sheet(wb,wsPB,'PB');
            }
            if (uasaData.length) {
                const wsUASA = XLSX.utils.json_to_sheet(uasaData);
                forceIdentityColumnsAsText(wsUASA);
                setUsefulColumnWidths(wsUASA);
                XLSX.utils.book_append_sheet(wb,wsUASA,'UASA');
            }
            if (otherData.length) {
                const wsOther = XLSX.utils.json_to_sheet(otherData);
                forceIdentityColumnsAsText(wsOther);
                setUsefulColumnWidths(wsOther);
                XLSX.utils.book_append_sheet(wb,wsOther,'DATA');
            }

            XLSX.writeFile(wb,previewFileName.innerText);
            const uniqueFiles = new Set(queue.map(i => `${i.file.name}|${i.file.size}`)).size;
            const pbParts = queue.filter(i => i.type === 'PB').length;
            const uasaParts = queue.filter(i => i.type === 'UASA').length;
            const years = [...new Set(queue.map(i => i.dataYear))].sort().join(', ');
            const sessions = [...new Set(queue.map(i => i.assessmentSession))].sort().join(' + ');
            showStatus(`Berjaya! ${uniqueFiles} fail digabungkan untuk ${currentSchoolName}. Tahun: ${years}. Sesi: ${sessions}. Komponen PB: ${pbParts}, UASA: ${uasaParts}.`, 'success');
        } catch (err) {
            console.error(err);
            showStatus('Ralat semasa proses penjanaan Excel. Sila semak Console untuk maklumat lanjut.', 'error');
        }
    });

    function showStatus(msg,type) {
        statusBox.innerText = msg;
        statusBox.className = `mt-6 p-4 rounded-xl text-[11px] font-bold text-center ${
            type === 'success' ? 'bg-green-100 text-green-700' :
            type === 'error' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700'
        }`;
        statusBox.classList.remove('hidden');
    }

    // Mod lalai
    setMode('class');
</script>
</body>
</html>
