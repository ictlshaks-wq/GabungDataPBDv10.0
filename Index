<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APLIKASI GABUNG DATA PBD V10.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Poppins:wght@300;400;500;600;700;800;900&display=swap');
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
        }
        .glass-card {
            background: transparent;
            border: 0;
            box-shadow: none;
        }
        .btn-gradient {
            background: linear-gradient(135deg,#1E3A8A 0%,#172554 100%);
            transition: all .3s ease;
        }
        .btn-gradient:hover:not(:disabled) {
            filter: brightness(1.2);
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,.1);
        }
        .file-list-item {
            animation: slideUp .35s cubic-bezier(.16,1,.3,1);
            border-left: 5px solid #3b82f6;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .auto-badge,.session-badge,.type-badge-pb,.type-badge-uasa,.type-badge-default {
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }
        .auto-badge { background:#f1f5f9; color:#64748b; }
        .session-badge { background:#dbeafe; color:#1d4ed8; }
        .type-badge-pb { background:#dcfce7; color:#166534; }
        .type-badge-uasa { background:#fef9c3; color:#854d0e; }
        .type-badge-default { background:#e0e7ff; color:#3730a3; }
        .warning-badge { background:#fee2e2; color:#991b1b; }
        .app-title {
            font-family: 'Oswald', sans-serif;
            text-transform: uppercase;
            letter-spacing: .035em;
            line-height: 1.05;
        }
        .brand-header { background: #1E3A8A; }
        .brand-accent { color: #1E3A8A; }
        .brand-badge { background: #1E3A8A; color: #fff; }
        .brand-dropzone:hover { border-color: #1E3A8A; background: #eff6ff; }
    </style>
</head>
<body class="p-4 md:p-6 lg:p-8">

<div class="glass-card w-full max-w-7xl mx-auto relative">
    <div class="relative z-10">
        <header class="brand-header mb-6 rounded-xl shadow-md p-6">
