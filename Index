                <p class="mb-3 text-[10px] font-black uppercase tracking-widest text-slate-500">Pilih Mod Aplikasi</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <button id="modeClassBtn" type="button"
